# --- Local setup (Docker Postgres + Ollama), the original build ---
DATABASE_URL=postgres://firmrag:firmrag_dev@localhost:5433/firmrag
LLM_PROVIDER=ollama
EMBED_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
CHAT_MODEL=qwen2.5:7b
CORPUS_DIR=/path/to/firm-rag-documents

